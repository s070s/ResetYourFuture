ASPNETCORE_ENVIRONMENT=Development

# Database
ConnectionStrings__DefaultConnection=Server=(localdb)\MSSQLLocalDB;Database=ResetYourFutureDb;Trusted_Connection=True;Connect Timeout=30;TrustServerCertificate=True;

# JWT signing key — must be >= 32 bytes in production
Jwt__Key=your-dev-jwt-key-change-in-production

# Admin seed account (required at startup)
AdminUser__Password=Admin123!!

# Dev seed data — only used when SeedData:Enabled=true (Development only)
SeedData__StudentPassword=Student123!!
# SeedData__BulkStudentCount=50

# Stripe webhook secret — get from Stripe Dashboard → Webhooks → signing secret
# Leave unset in dev; signature verification is skipped when this is absent.
# Payment__WebhookSecret=whsec_...

# Allowed hosts — restrict to your production domain in prod (prevents host-header poisoning).
# AllowedHosts=reset-your-future.com;www.reset-your-future.com
