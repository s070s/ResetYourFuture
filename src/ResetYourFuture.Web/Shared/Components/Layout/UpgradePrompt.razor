@* Renders the upgrade-prompt lock block for subscription-gated features. *@

<div class="upgrade-prompt">
    <div class="upgrade-icon" aria-hidden="true">🔒</div>
    <h4>@string.Format(PricingRes.PlanRequired, PlanName)</h4>
    <p>@Description</p>
    <a href="@PricingPath" class="btn btn-primary">@UpgradeButtonText</a>
</div>

@code {
    [Parameter] public string PlanName { get; set; } = "Plus";
    [Parameter] public string FeatureName { get; set; } = GlobalRes.ThisFeature;
    [Parameter] public string Description { get; set; } = "";
    [Parameter] public string PricingPath { get; set; } = "/pricing";
    [Parameter] public string UpgradeButtonText { get; set; } = PricingRes.UpgradeNow;
}
