@* Renders the full admin pagination toolbar: "Showing X–Y of Z items" + Rows select + Prev/Page N of M/Next. *@

<div class="pagination-toolbar-admin">
    <small class="text-light-muted">
        @string.Format(GlobalRes.PaginationShowingFormat, ((CurrentPage - 1) * PageSize) + 1, Math.Min(CurrentPage * PageSize, TotalCount), TotalCount, ItemLabel)
    </small>
    <div class="pagination-controls">
        <label class="form-label mb-0 text-light-muted small" for="@_pageSizeId">@GlobalRes.PaginationRows</label>
        <select id="@_pageSizeId" class="form-select form-select-sm" style="width:auto" value="@PageSize" @onchange="HandlePageSizeChanged">
            @foreach (var opt in PageSizeOptions)
            {
                <option value="@opt">@opt</option>
            }
        </select>
        <button class="btn btn-sm btn-outline-secondary"
                @onclick="OnPreviousPage"
                disabled="@(!HasPreviousPage)">‹ @GlobalRes.PaginationPrev</button>
        <span class="small">@string.Format(GlobalRes.PaginationPageOfFormat, CurrentPage, TotalPages)</span>
        <button class="btn btn-sm btn-outline-secondary"
                @onclick="OnNextPage"
                disabled="@(!HasNextPage)">@GlobalRes.PaginationNext ›</button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public int CurrentPage { get; set; }
    [Parameter, EditorRequired] public int TotalPages { get; set; }
    [Parameter, EditorRequired] public int TotalCount { get; set; }
    [Parameter, EditorRequired] public int PageSize { get; set; }
    [Parameter, EditorRequired] public bool HasPreviousPage { get; set; }
    [Parameter, EditorRequired] public bool HasNextPage { get; set; }
    [Parameter] public int[] PageSizeOptions { get; set; } = [10, 25, 50, 100];
    [Parameter] public string ItemLabel { get; set; } = "items";
    [Parameter] public EventCallback<int> OnPageSizeChanged { get; set; }
    [Parameter] public EventCallback OnPreviousPage { get; set; }
    [Parameter] public EventCallback OnNextPage { get; set; }

    private readonly string _pageSizeId = "page-size-" + Guid.NewGuid().ToString("N");

    private async Task HandlePageSizeChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var size))
        {
            await OnPageSizeChanged.InvokeAsync(size);
        }
    }
}
