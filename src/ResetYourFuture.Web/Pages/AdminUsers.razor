@page "/admin/users"
@attribute [Authorize(Roles = "Admin")]
@using ResetYourFuture.Web.Shared.Components.Data

<PageTitle>@AdminRes.UserManagement</PageTitle>

<div class="admin-container">
    <h1 class="h2">@AdminRes.UserManagement</h1>

    <DismissibleAlert Message="@message" AlertType="@messageType" OnDismiss="@(() => message = string.Empty)" />

    <div class="mb-3">
        <input type="text" class="form-control" placeholder="@AdminRes.SearchByEmailOrName"
               aria-label="@AdminRes.SearchByEmailOrName"
               value="@searchTerm" @oninput="OnSearchInput" />
    </div>

    <AuthorizeView Roles="Admin">
        <Authorized>
            @if (_loadFailed)
            {
                <button class="btn btn-secondary" @onclick="LoadUsers">@GlobalRes.TryAgain</button>
            }
            else if (pagedResult == null)
            {
                <SkeletonBlock Rows="8" Height="2.75rem" />
            }
            else if (!pagedResult.Items.Any())
            {
                <p>@AdminRes.NoUsersFound</p>
            }
            else
            {
                <ScrollableTable Items="pagedResult.Items" TItem="AdminUserDto">
                    <HeaderRow>
                        <tr>
                            <SortableColumnHeader ColumnKey="email"     Label="@AdminRes.ColEmail"
                                                  CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                                  OnSort="OnSort" />
                            <SortableColumnHeader ColumnKey="firstname" Label="@AdminRes.ColName"
                                                  CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                                  OnSort="OnSort" />
                            <th>@AdminRes.ColStatus</th>
                            <SortableColumnHeader ColumnKey="lastseenat" Label="@AdminRes.ColOnline"
                                                  CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                                  OnSort="OnSort" />
                            <SortableColumnHeader ColumnKey="isenabled" Label="@AdminRes.ColEnabled"
                                                  CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                                  OnSort="OnSort" />
                            <SortableColumnHeader ColumnKey="emailconfirmed" Label="@AdminRes.ColEmailConfirmed"
                                                  CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                                  OnSort="OnSort" />
                            <SortableColumnHeader ColumnKey="tier" Label="@AdminRes.ColTier"
                                                  CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                                  OnSort="OnSort" />
                            <th>@AdminRes.ColRoles</th>
                            <SortableColumnHeader ColumnKey="createdat" Label="@AdminRes.ColCreated"
                                                  CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                                  OnSort="OnSort" />
                            <th>@AdminRes.ColActions</th>
                        </tr>
                    </HeaderRow>
                    <RowTemplate Context="user">
                        <tr @key="user.Id">
                            <td data-label="@AdminRes.ColEmail">@user.Email</td>
                            <td data-label="@AdminRes.ColName">@user.FirstName @user.LastName</td>
                            <td data-label="@AdminRes.ColStatus">@user.Status</td>
                            <td data-label="@AdminRes.ColOnline">
                                <PresenceIndicator UserId="@user.Id" LastSeenAt="@user.LastSeenAt" ShowLabel="true" />
                            </td>
                            <td data-label="@AdminRes.ColEnabled">
                                <span aria-hidden="true">@(user.IsEnabled ? "✓" : "✗")</span>
                                <span class="visually-hidden">@(user.IsEnabled ? AdminRes.Yes : AdminRes.No)</span>
                            </td>
                            <td data-label="@AdminRes.ColEmailConfirmed">
                                <span aria-hidden="true">@(user.EmailConfirmed ? "✓" : "✗")</span>
                                <span class="visually-hidden">@(user.EmailConfirmed ? AdminRes.Yes : AdminRes.No)</span>
                            </td>
                            <td data-label="@AdminRes.ColTier">@user.SubscriptionTier</td>
                            <td data-label="@AdminRes.ColRoles">@string.Join(", ", user.Roles)</td>
                            <td data-label="@AdminRes.ColCreated">@user.CreatedAt.ToLocalTime().ToString("d")</td>
                            <td data-label="@AdminRes.ColActions">
                                @if (user.Roles.Contains("Student"))
                                {
                                    <button class="btn btn-sm btn-primary me-1" @onclick="() => ImpersonateUser(user.Id)">@AdminRes.LoginAs</button>
                                }
                                @if (!user.Roles.Contains("Admin"))
                                {
                                    <button class="btn btn-sm btn-warning" @onclick="() => OpenResetPasswordModal(user)">@AdminRes.ResetPassword</button>
                                }
                                @if (!user.Roles.Contains("Admin"))
                                {
                                    @if (user.IsEnabled)
                                    {
                                        <button class="btn btn-sm btn-secondary" @onclick="() => SetUserEnabled(user.Id, false)">@AdminRes.DisableUser</button>
                                    }
                                    else
                                    {
                                        <button class="btn btn-sm btn-success" @onclick="() => SetUserEnabled(user.Id, true)">@AdminRes.EnableUser</button>
                                    }
                                }
                                @if (!user.Roles.Contains("Admin"))
                                {
                                    <button class="btn btn-sm btn-outline-danger" @onclick="() => RequestDeleteUser(user.Id)">@AdminRes.Delete</button>
                                }
                            </td>
                        </tr>
                    </RowTemplate>
                </ScrollableTable>

                <AdminPaginationToolbar CurrentPage="pagedResult.Page"
                                        TotalPages="pagedResult.TotalPages"
                                        TotalCount="pagedResult.TotalCount"
                                        PageSize="pagedResult.PageSize"
                                        HasPreviousPage="pagedResult.HasPreviousPage"
                                        HasNextPage="pagedResult.HasNextPage"
                                        PageSizeOptions="PageSizeOptions"
                                        ItemLabel="@AdminRes.ItemLabelUsers"
                                        OnPageSizeChanged="OnPageSizeChanged"
                                        OnPreviousPage="PreviousPage"
                                        OnNextPage="NextPage" />
            }
        </Authorized>
        <NotAuthorized>
            <div class="alert alert-danger">
                @AdminRes.AccessDenied
            </div>
        </NotAuthorized>
    </AuthorizeView>
</div>

<FormModal IsVisible="_resetPwdModalVisible"
           Title="@(string.Format(AdminRes.ResetPasswordFor, _resetPwdEmail))"
           OnClose="CloseResetPasswordModal">
    <Body>
        @if (_resetPwdError is not null)
        {
            <div class="alert alert-danger py-1">@_resetPwdError</div>
        }
        <div class="mb-3">
            <label class="form-label" for="reset-pwd-new">@AdminRes.NewPassword</label>
            <input id="reset-pwd-new" type="password" class="form-control" aria-describedby="reset-pwd-help" @bind="_resetPwdNew" />
            <div class="form-text" id="reset-pwd-help">@GlobalRes.PasswordRulesHint</div>
        </div>
        <div class="mb-3">
            <label class="form-label" for="reset-pwd-confirm">@AdminRes.ConfirmPasswordLabel</label>
            <input id="reset-pwd-confirm" type="password" class="form-control" @bind="_resetPwdConfirm" />
        </div>
    </Body>
    <Footer>
        <button class="btn btn-secondary" @onclick="CloseResetPasswordModal" disabled="@_resetPwdBusy">
            @AdminRes.Cancel
        </button>
        <button class="btn btn-warning" @onclick="SubmitResetPassword" disabled="@_resetPwdBusy">
            @if (_resetPwdBusy)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            }
            @AdminRes.SetPassword
        </button>
    </Footer>
</FormModal>

<ConfirmModal IsVisible="@(confirmDeleteId is not null)"
              Title="@AdminRes.ConfirmTitle"
              Message="@AdminRes.ConfirmDeleteUser"
              ConfirmLabel="@AdminRes.Delete"
              CancelLabel="@AdminRes.Cancel"
              OnConfirm="DeleteUser"
              OnCancel="CancelDeleteUser" />
