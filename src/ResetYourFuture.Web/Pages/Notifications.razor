@page "/notifications"
@attribute [Authorize]

<PageTitle>@NotificationRes.PageTitle</PageTitle>

<div class="admin-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h2">@NotificationRes.PageTitle</h1>
        @if (pagedResult is { Items.Count: > 0 } && pagedResult.Items.Any(n => !n.IsRead))
        {
            <button class="btn btn-outline-secondary" @onclick="MarkAllReadAsync">@NotificationRes.MarkAllRead</button>
        }
    </div>

    @if (pagedResult == null)
    {
        <LoadingSpinner Label="@NotificationRes.Loading" />
    }
    else if (!pagedResult.Items.Any())
    {
        <p>@NotificationRes.Empty</p>
    }
    else
    {
        <ScrollableTable Items="pagedResult.Items" TItem="NotificationDto">
            <HeaderRow>
                <tr>
                    <th>@NotificationRes.ColMessage</th>
                    <SortableColumnHeader ColumnKey="createdat" Label="@NotificationRes.ColCreated"
                                          CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                          OnSort="OnSort" />
                    <SortableColumnHeader ColumnKey="isread" Label="@NotificationRes.ColStatus"
                                          CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                          OnSort="OnSort" />
                    <th>@NotificationRes.ColActions</th>
                </tr>
            </HeaderRow>
            <RowTemplate Context="notification">
                <tr @key="notification.Id" class="@(notification.IsRead ? "" : "table-active")">
                    <td data-label="@NotificationRes.ColMessage">
                        @if (!string.IsNullOrEmpty(notification.LinkUrl))
                        {
                            <a href="@notification.LinkUrl">@NotificationMessageFormatter.Format(notification)</a>
                        }
                        else
                        {
                            @NotificationMessageFormatter.Format(notification)
                        }
                    </td>
                    <td data-label="@NotificationRes.ColCreated">@notification.CreatedAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")</td>
                    <td data-label="@NotificationRes.ColStatus">
                        <StatusBadge IsActive="notification.IsRead"
                                     ActiveText="@NotificationRes.StatusRead"
                                     InactiveText="@NotificationRes.StatusUnread" />
                    </td>
                    <td data-label="@NotificationRes.ColActions">
                        @if (!notification.IsRead)
                        {
                            <button class="btn btn-sm btn-outline-primary" @onclick="() => MarkReadAsync(notification.Id)">@NotificationRes.MarkRead</button>
                        }
                    </td>
                </tr>
            </RowTemplate>
        </ScrollableTable>

        <AdminPaginationToolbar CurrentPage="pagedResult.Page"
                                TotalPages="pagedResult.TotalPages"
                                TotalCount="pagedResult.TotalCount"
                                PageSize="pagedResult.PageSize"
                                HasPreviousPage="pagedResult.HasPreviousPage"
                                HasNextPage="pagedResult.HasNextPage"
                                PageSizeOptions="PageSizeOptions"
                                ItemLabel="@NotificationRes.Title"
                                OnPageSizeChanged="OnPageSizeChanged"
                                OnPreviousPage="PreviousPage"
                                OnNextPage="NextPage" />
    }
</div>
