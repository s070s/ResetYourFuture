@page "/courses"
@attribute [Authorize]

<PageTitle>@CourseRes.CoursesPageTitle</PageTitle>

<h1>@CourseRes.AvailableCourses</h1>

@if (_loading)
{
    <SkeletonBlock Rows="4" Height="7rem" Gap="1rem" />
}
else if (_error is not null)
{
    <p class="text-danger">@_error</p>
    <button class="btn btn-secondary" @onclick="LoadCoursesAsync">@GlobalRes.TryAgain</button>
}
else if (_pagedResult is null || (_pagedResult.TotalCount == 0 && !HasActiveFilter))
{
    <p>@CourseRes.NoCoursesAvailable</p>
}
else
{
    @if (_maxCourses != int.MaxValue)
    {
        <div class="plan-limit-banner @(_enrolledCount >= _maxCourses ? "plan-limit-full" : "")">
            <span>@string.Format(CourseRes.PlanCourseLimitFormat, _userStatus?.PlanName ?? "Free", _maxCourses)</span>
            @if (_enrolledCount >= _maxCourses)
            {
                <span class="slots-full-label">@CourseRes.CourseSlotsFullNotice</span>
            }
            <button class="btn btn-sm btn-outline-primary" @onclick="GoToPricing">@CourseRes.UpgradePlan</button>
        </div>
    }

    <CategoryFilterBar Categories="_categories"
                        SelectedCategoryId="_selectedCategoryId"
                        OnCategorySelected="OnCategorySelected"
                        SearchText="@_search"
                        OnSearchChanged="OnSearchChanged"
                        SearchPlaceholder="@CategoryRes.SearchPlaceholder" />

    @if (_pagedResult.TotalCount == 0)
    {
        <p>@CategoryRes.NoMatchingResults</p>
    }
    else
    {
        <div class="pagination-toolbar">
            <span class="pagination-info">
                @string.Format(CourseRes.TotalCoursesFormat, _pagedResult.TotalCount)
            </span>
            <div class="page-size-selector">
                <label for="pageSizeSelect">@CourseRes.PerPage</label>
                <select id="pageSizeSelect" class="form-select form-select-sm"
                        value="@_pageSize"
                        @onchange="e => ChangePageSize(int.Parse(e.Value!.ToString()!))">
                    @foreach (var size in PageSizeOptions)
                    {
                        <option value="@size" selected="@(_pageSize == size)">@size</option>
                    }
                </select>
            </div>
        </div>

        <div class="courses-list stagger">
            @foreach (var course in _pagedResult.Items)
            {
                var isLocked = _userTier < course.RequiredTier && !course.IsEnrolled;

                <div class="course-card @(isLocked ? "course-locked" : "")" @key="course.Id">
                    <div class="course-card-header">
                        <h3>
                            <a class="course-card-link" href="@(isLocked ? "/pricing" : $"/courses/{course.Id}")">@course.Title</a>
                        </h3>
                        <div class="d-flex align-items-center gap-2">
                            @if (course.CategoryName is not null)
                            {
                                <span class="category-chip">@course.CategoryName</span>
                            }
                            @if (course.RequiredTier != SubscriptionTier.Free)
                            {
                                <span class="tier-badge tier-@course.RequiredTier.ToString().ToLowerInvariant()">
                                    @course.RequiredTier
                                </span>
                            }
                        </div>
                    </div>
                    @if (course.AverageRating is { } rating)
                    {
                        <div class="course-card-rating">
                            <StarRating Value="rating" AriaLabel="@string.Format(ReviewRes.RatingSummaryFormat, rating, course.ReviewCount)" />
                            <span class="rating-count">(@course.ReviewCount)</span>
                        </div>
                    }
                    @if (!string.IsNullOrEmpty(course.Description))
                    {
                        <div class="description">@((MarkupString)course.Description)</div>
                    }
                    <div class="meta">
                        <span class="lessons">@string.Format(CourseRes.LessonsCountFormat, course.TotalLessons)</span>
                        @if (course.IsEnrolled)
                        {
                            <span class="enrolled-badge">@CourseRes.Enrolled</span>
                        }
                        @if (isLocked)
                        {
                            @* Visual label only — the whole card already links to /pricing for locked courses. *@
                            <span class="locked-badge">
                                @string.Format(CourseRes.UpgradeToFormat, course.RequiredTier)
                            </span>
                        }
                    </div>
                </div>
            }
        </div>

        <PaginationNav CurrentPage="_page"
                        TotalPages="_pagedResult.TotalPages"
                        HasPreviousPage="_pagedResult.HasPreviousPage"
                        HasNextPage="_pagedResult.HasNextPage"
                        PreviousLabel="@CourseRes.Previous"
                        NextLabel="@CourseRes.Next"
                        AriaLabel="Course pages"
                        OnPageChanged="GoToPage" />
    }
}


