@page "/admin/categories"
@attribute [Authorize(Roles = "Admin")]
@using ResetYourFuture.Web.Shared.Components.Data

<PageTitle>@CategoryRes.CategoriesPageTitle</PageTitle>

<div class="admin-container">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h1 class="h2">@CategoryRes.CategoriesPageTitle</h1>
        <button class="btn btn-success" @onclick="ShowAddModal">@CategoryRes.AddCategory</button>
    </div>

    @if (pagedResult == null)
    {
        <LoadingSpinner Label="@CategoryRes.LoadingCategories" />
    }
    else if (!pagedResult.Items.Any())
    {
        <p>@CategoryRes.NoCategories</p>
    }
    else
    {
        <ScrollableTable Items="pagedResult.Items" TItem="AdminCategoryDto">
            <HeaderRow>
                <tr>
                    <SortableColumnHeader ColumnKey="nameen" Label="@CategoryRes.ColNameEn"
                                          CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                          OnSort="OnSort" />
                    <SortableColumnHeader ColumnKey="nameel" Label="@CategoryRes.ColNameEl"
                                          CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                          OnSort="OnSort" />
                    <SortableColumnHeader ColumnKey="coursecount" Label="@CategoryRes.ColCourseCount"
                                          CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                          OnSort="OnSort" />
                    <SortableColumnHeader ColumnKey="assessmentcount" Label="@CategoryRes.ColAssessmentCount"
                                          CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                          OnSort="OnSort" />
                    <SortableColumnHeader ColumnKey="createdat" Label="@CategoryRes.ColCreated"
                                          CurrentSortBy="@_sortBy" CurrentSortDir="@_sortDir"
                                          OnSort="OnSort" />
                    <th>@CategoryRes.ColActions</th>
                </tr>
            </HeaderRow>
            <RowTemplate Context="category">
                <tr @key="category.Id">
                    <td data-label="@CategoryRes.ColNameEn">@category.NameEn</td>
                    <td data-label="@CategoryRes.ColNameEl">@(category.NameEl ?? "—")</td>
                    <td data-label="@CategoryRes.ColCourseCount">@category.CourseCount</td>
                    <td data-label="@CategoryRes.ColAssessmentCount">@category.AssessmentCount</td>
                    <td data-label="@CategoryRes.ColCreated">@category.CreatedAt.ToLocalTime().ToString("d")</td>
                    <td data-label="@CategoryRes.ColActions">
                        <button class="btn btn-sm btn-outline-primary" @onclick="() => ShowEditModal(category)">@CategoryRes.Rename</button>
                        <button class="btn btn-sm btn-outline-danger" @onclick="() => RequestDelete(category)">@AdminRes.Delete</button>
                    </td>
                </tr>
            </RowTemplate>
        </ScrollableTable>

        <AdminPaginationToolbar CurrentPage="pagedResult.Page"
                                TotalPages="pagedResult.TotalPages"
                                TotalCount="pagedResult.TotalCount"
                                PageSize="pagedResult.PageSize"
                                HasPreviousPage="pagedResult.HasPreviousPage"
                                HasNextPage="pagedResult.HasNextPage"
                                PageSizeOptions="PageSizeOptions"
                                ItemLabel="@AdminRes.ItemLabelCategories"
                                OnPageSizeChanged="OnPageSizeChanged"
                                OnPreviousPage="PreviousPage"
                                OnNextPage="NextPage" />
    }

    <DismissibleAlert Message="@message" OnDismiss="@(() => message = string.Empty)" />
</div>

<FormModal IsVisible="_formModalVisible"
           Title="@(_editingId is null ? CategoryRes.AddCategory : CategoryRes.Rename)"
           OnClose="CloseFormModal">
    <Body>
        @if (_formError is not null)
        {
            <div class="alert alert-danger py-1">@_formError</div>
        }
        <div class="mb-3">
            <label class="form-label">@CategoryRes.NameEnLabel</label>
            <input class="form-control" @bind="_formNameEn" />
        </div>
        <div class="mb-3">
            <label class="form-label">@CategoryRes.NameElLabel</label>
            <input class="form-control" @bind="_formNameEl" />
        </div>
    </Body>
    <Footer>
        <button class="btn btn-secondary" @onclick="CloseFormModal" disabled="@_isSaving">@AdminRes.Cancel</button>
        <button class="btn btn-primary" @onclick="SubmitForm" disabled="@(_isSaving || string.IsNullOrWhiteSpace(_formNameEn))">
            @if (_isSaving)
            {
                <span class="spinner-border spinner-border-sm me-1" role="status"></span>
            }
            @AdminRes.Save
        </button>
    </Footer>
</FormModal>

<ConfirmModal IsVisible="@(_pendingDelete is not null)"
              Title="@AdminRes.ConfirmTitle"
              Message="@(_pendingDelete is not null ? string.Format(CategoryRes.DeleteConfirmFormat, _pendingDelete.NameEn, _pendingDelete.CourseCount, _pendingDelete.AssessmentCount) : "")"
              ConfirmLabel="@AdminRes.Delete"
              CancelLabel="@AdminRes.Cancel"
              OnConfirm="ConfirmDelete"
              OnCancel="CancelDelete" />
