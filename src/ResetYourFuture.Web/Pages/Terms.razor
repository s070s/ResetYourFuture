@page "/terms"

<PageTitle>@LegalRes.TermsTitle</PageTitle>

<div class="legal-page">
    <article class="legal-content">
        <header class="legal-header">
            <h1>@LegalRes.TermsTitle</h1>
            <p class="legal-updated">@LegalRes.LastUpdated</p>
        </header>

        <div class="legal-notice" role="note">
            <strong>@LegalRes.EducationalNoticeTitle.</strong>
            @LegalRes.EducationalNotice
        </div>

        <p class="legal-intro">@LegalRes.TermsIntro</p>

        <section>
            <h2>@LegalRes.TermsServiceTitle</h2>
            <p>@LegalRes.TermsServiceBody</p>
        </section>

        <section>
            <h2>@LegalRes.TermsAccountsTitle</h2>
            <p>@LegalRes.TermsAccountsBody</p>
        </section>

        <section>
            <h2>@LegalRes.TermsAcceptableTitle</h2>
            <p>@LegalRes.TermsAcceptableBody</p>
        </section>

        <section>
            <h2>@LegalRes.TermsContentTitle</h2>
            <p>@LegalRes.TermsContentBody</p>
        </section>

        <section>
            <h2>@LegalRes.TermsAssessmentsTitle</h2>
            <p>@LegalRes.TermsAssessmentsBody</p>
        </section>

        <section>
            <h2>@LegalRes.TermsDisclaimerTitle</h2>
            <p>@LegalRes.TermsDisclaimerBody</p>
        </section>

        <section>
            <h2>@LegalRes.TermsChangesTitle</h2>
            <p>@LegalRes.TermsChangesBody</p>
        </section>

        <footer class="legal-footer">
            <a href="/privacy">@LegalRes.PrivacyTitle</a>
            <a href="/"><span aria-hidden="true">←</span> @HomeRes.BackToHome</a>
        </footer>
    </article>
</div>
