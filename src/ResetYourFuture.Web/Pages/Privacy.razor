@page "/privacy"

<PageTitle>@LegalRes.PrivacyTitle</PageTitle>

<div class="legal-page">
    <article class="legal-content">
        <header class="legal-header">
            <h1>@LegalRes.PrivacyTitle</h1>
            <p class="legal-updated">@LegalRes.LastUpdated</p>
        </header>

        <div class="legal-notice" role="note">
            <strong>@LegalRes.EducationalNoticeTitle.</strong>
            @LegalRes.EducationalNotice
        </div>

        <p class="legal-intro">@LegalRes.PrivacyIntro</p>

        <section>
            <h2>@LegalRes.PrivacyDataTitle</h2>
            <p>@LegalRes.PrivacyDataBody</p>
        </section>

        <section>
            <h2>@LegalRes.PrivacyPurposeTitle</h2>
            <p>@LegalRes.PrivacyPurposeBody</p>
        </section>

        <section>
            <h2>@LegalRes.PrivacySpecialTitle</h2>
            <p>@LegalRes.PrivacySpecialBody</p>
        </section>

        <section>
            <h2>@LegalRes.PrivacyRetentionTitle</h2>
            <p>@LegalRes.PrivacyRetentionBody</p>
        </section>

        <section>
            <h2>@LegalRes.PrivacyRightsTitle</h2>
            <p>@LegalRes.PrivacyRightsBody</p>
        </section>

        <section>
            <h2>@LegalRes.PrivacyCookiesTitle</h2>
            <p>@LegalRes.PrivacyCookiesBody</p>
        </section>

        <section>
            <h2>@LegalRes.PrivacyContactTitle</h2>
            <p>@LegalRes.PrivacyContactBody</p>
        </section>

        <footer class="legal-footer">
            <a href="/terms">@LegalRes.TermsTitle</a>
            <a href="/"><span aria-hidden="true">←</span> @HomeRes.BackToHome</a>
        </footer>
    </article>
</div>
