@using ResetYourFuture.Web.Pages

<Router AppAssembly="@typeof(Routes).Assembly" NotFoundPage="typeof(NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
            <NotAuthorized>
                <p role="alert">@GlobalRes.NotAuthorizedMessage <a href="/login">@GlobalRes.Label_Login</a></p>
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
</Router>
